RESPOND STRICTLY IN JSON FORMAT:
{
  "intent": "add_item" | "consume_item" | "move_item" | "delete_item",
  "confidence_score": 0.0 to 1.0,
  "item_details": {
    "name": "EXTREMELY SPECIFIC name/description (e.g., 'серо-чёрные носки с потёртостями')",
    "location": "Name of the storage location if specified (e.g. 'комод', 'холодильник', 'сейф', 'тумба под телевизор') or null",
    "quantity": number or null (CRITICAL: If the item is a natural pair like shoes, socks, or earrings, count ONE PAIR as quantity 1 with unit 'pair' or 'пара'. Do NOT count as 2 items unless there are 2 pairs),
    "unit_of_measure": "pcs" | "pair" | "ml" | "mg" | "kg" | "уп" | null,
    "primary_category": "MEDICINES" | "DOCUMENTS" | "CLOTHES" | "TECH" | "FOOD" | "DISHES" | "COSMETICS" | "HOUSEHOLD" | "HOBBY" | "OTHER",
    "secondary_categories": [] or null,
    "tags": ["extracted", "tags"] or null,
    "synonyms": ["synonyms"] or null,
    "merge_with_item_id": "If 'add_item' and the item is 100% IDENTICAL to an item in the RAG Context, output its UUID here. Else null.",
    {% if 'DOCUMENTS' in classes_str %}
    "document_summary": "Concise summary of the most important information from the document/flyer/manual (do NOT do full OCR)",
    {% endif %}
    "attributes": {
      {% if 'MEDICINES' in classes_str or 'FOOD' in classes_str or 'COSMETICS' in classes_str or 'HOUSEHOLD' in classes_str %}
      "expiry_date": "YYYY-MM-DD" or null (CRITICAL: aggressively scan ALL corners/sides of the product packaging via OCR for dates like DD.MM.YYYY, MM.YYYY or MM/YY. Also, if the user mentions relative expiration like 'послезавтра' or 'через месяц', translate it to a YYYY-MM-DD format as best as possible, or at least preserve it so schedule_parser can use it),
      {% endif %}
      ... (other specific attributes based on category rules)
    }
  },
  "move_details": {
    "item_name": "string or null",
    "target_item_id": "UUID from RAG Context or null",
    "from_location": "string or null",
    "to_location": "name of target location (e.g. 'комод', 'шкаф', 'полка') or null"
