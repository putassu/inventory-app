# Скопируйте в .env.local. Секреты создаются при установке, в Git их нет.
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_PASSWORD=replace-with-another-long-random-password
INV_JWT_SECRET=replace-with-at-least-32-random-characters
INV_DATABASE_URL=postgresql+asyncpg://inventory:replace-with-a-long-random-password@127.0.0.1:55432/inventory
INV_REDIS_URL=redis://127.0.0.1:16379/0
INV_QDRANT_URL=http://127.0.0.1:56333
INV_STORAGE_BACKEND=s3
INV_S3_ENDPOINT=http://127.0.0.1:59000
INV_S3_ACCESS_KEY=inventory
INV_S3_SECRET_KEY=replace-with-another-long-random-password
INV_S3_BUCKET=inventory-private
# Единый шлюз; доверие относится только к указанным локальным alias, не к облачной модели.
INV_LITELLM_URL=https://as.rsmu.ru/litellm
INV_LITELLM_KEY=
INV_LITELLM_TRUSTED=true
INV_LOCAL_MODEL=local-gemma-4
INV_LOCAL_IMAGE_MAX_SIDE=512
INV_LOCAL_IMAGE_MAX_BYTES=262144
INV_LOG_LEVEL=INFO
INV_EMBEDDING_MODEL=local-bge-m3
INV_CORS_ORIGINS=["https://inventory.example.org"]
INV_COOKIE_SECURE=true
# ASR и OCR используют маленькую локальную модель. Подтвердите аудио после проверки.
INV_LOCAL_AUDIO_MODEL=local-gemma-4-e4b
INV_LOCAL_AUDIO_VERIFIED=false
INV_LOCAL_GATEKEEPER_MODEL=local-gemma-4-e4b
# Облако разрешается отдельно через настройки и проверку приватности.
INV_CLOUD_API=openai
INV_CLOUD_MODEL=gemini-3.5-flash-lite
INV_CLOUD_JSON_MODE=true
# При пустом INV_LITELLM_URL поддерживается прежний режим Ollama / прямого провайдера.
INV_OLLAMA_URL=http://127.0.0.1:11434
